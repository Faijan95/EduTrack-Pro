@using X.PagedList.Mvc.Core
@using X.PagedList
@model X.PagedList.IPagedList<StudentManagementSystem.Models.Contact>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet" />

<div class="dashboard-layout">

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="admin-profile">

            <img src="/Images/admin.png" alt="Admin" />

            <h2>Admin</h2>

            <p>Administrator</p>

        </div>

        <ul class="sidebar-menu">

            <li>
                <a href="/Home/Dashboard">
                    Dashboard
                </a>
            </li>

       

            <li>
                <a href="/Home/Dashboard?status=Approved">
                    Approved
                </a>
            </li>

            <li>
                <a href="/Home/Dashboard?status=Pending">
                    Pending
                </a>
            </li>

        </ul>

    </div>

    <!-- MAIN CONTENT -->

    <div class="main-content">

        <!-- HEADER -->

        <div class="dashboard-header">

            <div class="header-left">

                <h1>Admin Dashboard</h1>

                <p>Welcome Back Admin 👋</p>

            </div>

            <div class="header-right">

                <img src="/Images/admin.png"
                     class="header-admin-img" />

                <a href="/Admin/Logout"
                   class="logout-btn">

                    Logout

                </a>

            </div>

        </div>

        <!-- CARDS -->

        <div class="dashboard-cards">

            <div class="dashboard-card blue-card">

                <h3>Total Contacts</h3>

                <h1>@ViewBag.TotalContacts</h1>

            </div>

            <div class="dashboard-card orange-card">

                <h3>Pending Messages</h3>

                <h1>@ViewBag.PendingContacts</h1>

            </div>

            <div class="dashboard-card green-card">

                <h3>Approved Messages</h3>

                <h1>@ViewBag.ApprovedContacts</h1>

            </div>

        </div>

        <!-- RECENT MESSAGES -->

        <div class="recent-box">

            <div class="recent-header">

                <h1>Recent Messages</h1>

                <button id="toggleBtn"
                        class="hide-btn"
                        onclick="toggleTable()">

                    Hide

                </button>

            </div>

            <!-- FILTER -->

            <form method="get"
                  id="filterForm">


                <input type="hidden"
                       name="status"
                       value="@ViewBag.Status" />


                <div class="filter-container">

                    <input type="text"
                           name="search"
                           id="searchInput"
                           value="@ViewBag.Search"
                           class="search-box"
                           placeholder="Search by name or email" />

                    <select id="rangeSelector"
                            name="rangeType"
                            class="range-select"
                            onchange="handleRangeChange()">

                        <option value="Select range">
                            Select range
                        </option>

                        <option value="today">
                            Today
                        </option>

                        <option value="yesterday">
                            Yesterday
                        </option>

                        <option value="7days">
                            Last 7 Days
                        </option>

                        <option value="30days">
                            Last 30 Days
                        </option>

                        <option value="custom">
                            Custom Range
                        </option>

                    </select>

                    <!-- CUSTOM DATE -->

                    <div id="customDateBox"
                         class="custom-date-box"
                         style="display:none;">

                        <input type="date"
                               name="startDate"
                               class="date-input"
                               value="@ViewBag.StartDate"
                               onchange="autoSubmitForm()" />

                        <input type="date"
                               name="endDate"
                               class="date-input"
                               value="@ViewBag.EndDate"
                               onchange="autoSubmitForm()" />

                    </div>

                </div>

            </form>

            <!-- TABLE -->

            <div class="table-responsive"
                 id="messageTable">

                <table class="custom-table">

                    <thead>

                        <tr>

                            <th>S.No</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Action</th>
                            <th>Date</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int count =
                            (Model.PageNumber - 1)
                            * Model.PageSize + 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@count</td>

                                <td>@item.FullName</td>

                                <td>@item.Email</td>

                                <td>@item.Phone</td>

                                <!-- STATUS -->

                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }

                                </td>

                                <!-- ACTION -->

                                <td>

                                    <div class="action-buttons">

                                        @if (item.Status != "Approved")
                                        {
                                            <a href="/Home/EditContact/@item.Id"
                                               class="btn btn-primary">

                                                Edit

                                            </a>

                                            <a href="/Home/Approve/@item.Id"
                                               class="btn btn-success">

                                                Approve

                                            </a>
                                        }

                                        <a href="/Home/DeleteContact/@item.Id"
                                           class="btn btn-danger"
                                           onclick="return confirm('Are you sure you want to delete this message?')">

                                            Delete

                                        </a>

                                    </div>

                                </td>

                                <!-- DATE -->

                                <td class="date-column">

                                    @item.CreatedDate.ToString("dd-MM-yyyy")

                                </td>

                            </tr>

                            count++;
                        }

                    </tbody>

                </table>

            </div>

            <!-- PAGINATION -->

            <div class="mt-4 d-flex justify-content-center">

                @Html.PagedListPager(
                         Model,
                         page => Url.Action("Dashboard",
                         new
                         {
                             page,
                             search = ViewBag.Search,
                             rangeType = ViewBag.RangeType,
                             startDate = ViewBag.StartDate,
                             endDate = ViewBag.EndDate
                         }),
                         new PagedListRenderOptions
                         {
                             LiElementClasses = new[] { "page-item" },
                             PageClasses = new[] { "page-link" }
                         })

            </div>

        </div>

    </div>

</div>

<script>

    let timer;

    document
        .getElementById("searchInput")
        .addEventListener("keyup", function () {

            clearTimeout(timer);

            timer = setTimeout(() => {

                document
                    .getElementById("filterForm")
                    .submit();

            }, 500);

        });

    function handleRangeChange() {

        const range =
            document.getElementById("rangeSelector").value;

        const customBox =
            document.getElementById("customDateBox");

        if (range === "custom") {

            customBox.style.display = "flex";
        }
        else {

            customBox.style.display = "none";

            document
                .getElementById("filterForm")
                .submit();
        }
    }

    function autoSubmitForm() {

        const start =
            document.querySelector(
                'input[name="startDate"]'
            ).value;

        const end =
            document.querySelector(
                'input[name="endDate"]'
            ).value;

        if (start !== "" && end !== "") {

            document
                .getElementById("filterForm")
                .submit();
        }
    }

    window.onload = function () {

        const range =
            document.getElementById("rangeSelector").value;

        const customBox =
            document.getElementById("customDateBox");

        if (range === "custom") {

            customBox.style.display = "flex";
        }
        else {

            customBox.style.display = "none";
        }
    }

    function toggleTable() {

        let table =
            document.getElementById("messageTable");

        let button =
            document.getElementById("toggleBtn");

        if (table.style.display === "none") {

            table.style.display = "block";

            button.innerText = "Hide";
        }
        else {

            table.style.display = "none";

            button.innerText = "Show";
        }
    }

</script>