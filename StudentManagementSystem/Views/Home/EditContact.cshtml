@model StudentManagementSystem.Models.Contact

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet">

<div class="container py-5">

    <div class="card p-4 shadow">

        <h2 class="mb-4">
            Edit Contact
        </h2>

        <form method="post">

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">

                <label>Name</label>

                <input asp-for="FullName"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label>Email</label>

                <input asp-for="Email"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label>Phone</label>

                <input asp-for="Phone"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label>Message</label>

                <textarea asp-for="Message"
                          class="form-control"></textarea>

            </div>

            <button class="btn btn-primary">

                Update

            </button>

        </form>

    </div>

</div>