@model StudentManagementSystem.Models.Student

<h2>Add Student</h2>

<<form asp-action="Create" method="post">

    <label>Name</label>
    <input type="text" asp-for="Name" />
    <br /><br />

    <label>Email</label>
    <input type="email" asp-for="Email" />
    <br /><br />

    <label>Course</label>
    <input type="text" asp-for="Course" />
    <br /><br />

    <button type="submit">Save</button>

</form>