        </div>

    </div>

</section>

<section class="about-section py-5"
         id="about">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-6 text-center mb-4"
                 data-aos="fade-right">

                <img src="~/Images/about.png"
                     class="img-fluid about-img"
                     width="450" />

            </div>

            <div class="col-md-6"
                 data-aos="fade-left">

                <h2 class="fw-bold display-5 mb-4">
                    About Our Company
                </h2>

                <p class="text-muted fs-5">
                    We are a professional team providing modern web solutions for businesses.
                </p>

                <p class="text-muted fs-5">
                    We focus on quality, performance, and customer satisfaction.
                </p>

                <button class="btn btn-primary px-4 py-2 mt-3">
                    Learn More
                </button>

            </div>

        </div>

    </div>

</section>


<section class="contact-section py-5"
         id="contact">

    <div class="container">

        <div class="text-center mb-5">

            <h1 class="contact-title">
                Contact Us
            </h1>

            <p class="contact-subtitle">
                Feel free to contact us anytime.
            </p>

        </div>

        <div class="row align-items-center">

            <div class="col-lg-6 text-center mb-4"
                 data-aos="fade-right">

                <img src="https://cdn-icons-png.flaticon.com/512/942/942748.png"
                     class="img-fluid contact-image" />

            </div>

            <div class="col-lg-6"
                 data-aos="zoom-in">

                <div class="contact-card shadow-lg">

                    <form asp-controller="Home"
                          asp-action="Contact"
                          method="post">

                        <div class="mb-3">

                            <label class="form-label custom-label">
                                Full Name
                            </label>

                            <input type="text"
                                   name="FullName"
                                   class="form-control custom-input"
                                   placeholder="Enter your name" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label custom-label">
                                Email Address
                            </label>

                            <input type="email"
                                   name="Email"
                                   class="form-control custom-input"
                                   placeholder="Enter your email" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label custom-label">
                                Phone Number
                            </label>

                            <input type="text"
                                   name="Phone"
                                   class="form-control custom-input"
                                   placeholder="Enter your phone" />

                        </div>

                        <div class="mb-4">

                            <label class="form-label custom-label">
                                Message
                            </label>

                            <textarea rows="5"
                                      name="Message"
                                      class="form-control custom-input"
                                      placeholder="Write your message"></textarea>

                        </div>

                        <button class="btn send-btn">
                            Send Message
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center">

        @TempData["SuccessMessage"]

    </div>
}




